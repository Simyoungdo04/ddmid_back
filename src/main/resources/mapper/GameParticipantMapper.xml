<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kh.midpoint.gameparticipant.model.dao.GameParticipantMapper">

	<select id="nextGameParticipantId" resultType="long">
		SELECT SEQ_GAME_PARTICIPANT.NEXTVAL FROM DUAL
	</select>

	<insert id="insert" parameterType="com.kh.midpoint.gameparticipant.model.vo.GameParticipant">
		INSERT INTO GAME_PARTICIPANT (
			GAME_PARTICIPANT_ID, PARTICIPANT_ID, ROOM_ID, GAME_SESSION_ID, IS_WINNER, JOINED_AT
		) VALUES (
			#{gameParticipantId}, #{participantId}, #{roomId}, #{gameSessionId}, #{isWinner}, #{joinedAt}
		)
	</insert>

	<delete id="deleteByRoomId">
		DELETE FROM GAME_PARTICIPANT WHERE ROOM_ID = #{roomId}
	</delete>

</mapper>
