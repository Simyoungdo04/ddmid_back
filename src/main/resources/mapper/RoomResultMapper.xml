<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kh.midpoint.roomresult.model.dao.RoomResultMapper">

	<resultMap id="restaurantDtoResultMap" type="com.kh.midpoint.restaurant.model.dto.RestaurantDto">
		<constructor>
			<arg column="ID" javaType="string"/>
			<arg column="NAME" javaType="string"/>
			<arg column="CATEGORY" javaType="string"/>
			<arg column="ADDRESS" javaType="string"/>
			<arg column="ROAD_ADDRESS" javaType="string"/>
			<arg column="PHONE" javaType="string"/>
			<arg column="PLACE_URL" javaType="string"/>
			<arg column="LAT" javaType="double"/>
			<arg column="LNG" javaType="double"/>
			<arg column="DISTANCE_METERS" javaType="_int"/>
		</constructor>
	</resultMap>

	<select id="nextResultId" resultType="long">
		SELECT SEQ_ROOM_RESULT.NEXTVAL FROM DUAL
	</select>

	<insert id="insert" parameterType="com.kh.midpoint.roomresult.model.vo.RoomResult">
		INSERT INTO ROOM_RESULT (RESULT_ID, ROOM_ID, RESTAURANT_ID, GAME_PARTICIPANT_ID)
		VALUES (#{resultId}, #{roomId}, #{restaurantId}, #{gameParticipantId})
	</insert>

	<select id="findResolvedRestaurantByRoomId" resultMap="restaurantDtoResultMap">
		SELECT
			TO_CHAR(r.KAKAO_PLACE_ID) AS ID, r.NAME, r.CATEGORY, r.ADDRESS, r.ROAD_ADDRESS,
			r.PHONE, r.PLACE_URL, r.LAT, r.LNG, 0 AS DISTANCE_METERS
		FROM ROOM_RESULT rr
		JOIN RESTAURANT r ON r.RESTAURANT_ID = rr.RESTAURANT_ID
		WHERE rr.ROOM_ID = #{roomId}
	</select>

	<delete id="deleteByRoomId">
		DELETE FROM ROOM_RESULT WHERE ROOM_ID = #{roomId}
	</delete>

</mapper>
